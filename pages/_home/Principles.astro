---
const principles = [
  {
    title: "Sharp contracts.",
    body: "Public APIs you can pin and reason about. Clear surfaces beat sprawling frameworks.",
  },
  {
    title: "Independent libraries.",
    body: "Pick what you need. MIT-licensed, no forced stack, no platform lock-in.",
  },
  {
    title: "Built for agents too.",
    body: "Machine-readable docs and predictable packages where agents work — not just humans reading guides.",
  },
] as const;
---

<section aria-labelledby="principles-heading">
  <div class="mx-auto max-w-2xl text-center">
    <h2
      class="font-medium text-3xl tracking-tight sm:text-4xl"
      id="principles-heading"
    >
      Why Stainless Code.
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-balance text-muted-foreground">
      How we ship open-source TypeScript and JavaScript libraries — without the
      platform pitch.
    </p>
  </div>

  <ol class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-3">
    {
      principles.map((principle, index) => (
        <li class="rounded-blume border border-border p-5 text-start">
          <p class="font-mono text-muted-foreground text-xs tracking-wider">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-3 font-medium text-lg tracking-tight">
            {principle.title}
          </h3>
          <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
            {principle.body}
          </p>
        </li>
      ))
    }
  </ol>
</section>
