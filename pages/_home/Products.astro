---
import Card from "blume/components/content/Card.astro";
import CardGroup from "blume/components/content/CardGroup.astro";
import { contentHref } from "blume/components/content/base-href.ts";
import codemapIcon from "./icons/codemap.svg?raw";
import layersIcon from "./icons/layers.svg?raw";
import persistIcon from "./icons/persist.svg?raw";
import { PRODUCTS } from "./products.ts";

const PRODUCT_ICONS = {
  codemap: codemapIcon,
  persist: persistIcon,
  layers: layersIcon,
} as const;
---

<section aria-labelledby="libraries-heading" id="libraries">
  <div class="mx-auto max-w-2xl text-center">
    <h2
      class="font-medium text-3xl tracking-tight sm:text-4xl"
      id="libraries-heading"
    >
      Browse the libraries.
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-balance text-muted-foreground">
      Open-source packages under Stainless Code. Open a card for docs, source,
      and npm — or see the full{" "}
      <a
        class="text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground"
        href={contentHref("/products")}
      >
        product index
      </a>
      .
    </p>
  </div>

  <div class="product-cards mt-10">
    <CardGroup cols={3}>
      {
        PRODUCTS.map((product) => (
          <Card
            arrow
            href={product.href}
            icon={PRODUCT_ICONS[product.icon]}
            title={product.name}
          >
            {product.pitch}
          </Card>
        ))
      }
    </CardGroup>
  </div>
</section>

<style>
  /* Inline SVG Icon adds a line-box strut under the mark — kill it so spacing
     matches the old <img> cards (mb-2.5 only, no extra leading). */
  .product-cards :global([data-blume-card] div:has(> span > .logo-svg)) {
    display: flex;
    line-height: 0;
  }

  .product-cards :global([data-blume-card] span:has(> .logo-svg)) {
    display: flex !important;
    height: 28px !important;
    width: 28px !important;
  }

  .product-cards :global([data-blume-card] .logo-svg) {
    display: block;
    height: 28px;
    width: 28px;
  }
</style>
