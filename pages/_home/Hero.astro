---
const primaryButton =
  "inline-flex items-center gap-1 rounded-blume bg-accent px-5 py-2.5 font-medium text-accent-foreground text-sm transition-opacity hover:opacity-90";
const secondaryLink =
  "inline-flex items-center gap-1 font-medium text-muted-foreground text-sm transition-colors hover:text-foreground";
---

<section class="text-center">
  <h1
    class="mx-auto max-w-3xl text-balance font-medium text-4xl tracking-tight sm:text-5xl lg:text-6xl"
  >
    <span class="block">Stainless Code</span>
    <span class="mt-2 block text-accent text-2xl sm:text-3xl lg:text-4xl">
      Open-source tooling for JS/TS and AI agents.
    </span>
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-balance text-foreground text-lg">
    Typed libraries with sharp contracts — for developers shipping modern apps,
    and for agents that need reliable structure instead of platform glue.
  </p>

  <div class="mt-9 flex flex-wrap items-center justify-center gap-6 text-sm">
    <a class={primaryButton} href="#libraries">
      Browse libraries
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </a>
    <a
      class={secondaryLink}
      href="https://github.com/stainless-code"
      rel="noreferrer"
      target="_blank"
    >
      View on GitHub
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </a>
  </div>
</section>
