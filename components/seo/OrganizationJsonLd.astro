---
import { COMPANY, SOCIAL_SAME_AS } from "../company";

/** Home uses PageLayout — no RootLayout JSON-LD, so emit Org/WebSite here. */
const description =
  "Open-source TypeScript and JavaScript libraries with sharp contracts — tooling for modern apps and AI-agent workflows.";

const orgJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": `${COMPANY.siteUrl}/#organization`,
      "@type": "Organization",
      name: COMPANY.name,
      url: COMPANY.siteUrl,
      logo: `${COMPANY.siteUrl}/logo.svg`,
      description,
      sameAs: [...SOCIAL_SAME_AS],
    },
    {
      "@id": `${COMPANY.siteUrl}/#website`,
      "@type": "WebSite",
      name: COMPANY.name,
      url: COMPANY.siteUrl,
      description,
      publisher: { "@id": `${COMPANY.siteUrl}/#organization` },
    },
  ],
}).replaceAll("<", "\\u003c");
---

<script is:inline set:html={orgJsonLd} type="application/ld+json" />
