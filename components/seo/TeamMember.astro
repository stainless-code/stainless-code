---
import { MAINTAINER } from "../company";

const links = [
  { href: `mailto:${MAINTAINER.email}`, label: "Email" },
  { href: MAINTAINER.github, label: "GitHub" },
  { href: MAINTAINER.linkedin, label: "LinkedIn" },
  { href: MAINTAINER.x, label: "X" },
  { href: MAINTAINER.bluesky, label: "Bluesky" },
] as const;
---

<div
  class="not-prose my-8 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8"
>
  <img
    alt={`${MAINTAINER.name}, ${MAINTAINER.role} at Stainless Code`}
    class="size-36 shrink-0 rounded-blume border border-border object-cover sm:size-40"
    height="160"
    src={MAINTAINER.image}
    width="160"
  />
  <div>
    <p class="m-0 font-medium text-foreground text-xl tracking-tight">
      {MAINTAINER.name}
    </p>
    <p class="mt-1 text-muted-foreground text-sm">{MAINTAINER.role}</p>
    <p class="mt-3 max-w-md text-muted-foreground text-sm leading-relaxed">
      Builds and maintains the open-source TypeScript and JavaScript libraries
      under Stainless Code.
    </p>
    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              class="text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground"
              href={link.href}
              {...(link.href.startsWith("mailto:")
                ? {}
                : { rel: "noreferrer", target: "_blank" })}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
