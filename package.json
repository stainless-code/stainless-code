{
  "name": "stainless-code",
  "private": true,
  "description": "Open-source TypeScript and JavaScript libraries with sharp contracts — tooling for modern apps and AI-agent workflows.",
  "homepage": "https://stainless-code.com/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-code/stainless-code.git"
  },
  "type": "module",
  "scripts": {
    "audit": "blume audit --fail-on error --skip canonical_bad_target,non_canonical_in_sitemap,indexable_page_not_in_sitemap,BLUME_AUDIT_LINK_TO_BROKEN,BLUME_AUDIT_INTERNAL_LINK_ABSOLUTE",
    "build": "blume build",
    "check": "blume check",
    "dev": "blume dev",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "lint-staged": "lint-staged",
    "prepare": "husky || true",
    "preview": "blume preview",
    "validate": "blume validate"
  },
  "dependencies": {
    "blume": "1.1.3"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.1.0",
    "oxfmt": "0.59.0"
  },
  "engines": {
    "bun": ">=1.0.31",
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
