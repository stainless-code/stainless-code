# Stainless Code company hub — Apache config for the domain root.
# Deployed by the Deploy docs workflow (FTP account scoped to domain root).
# Do NOT list .htaccess in the workflow exclude — it rides along in dist/.
# Deploy exclude keeps /codemap /persist /layers /lossless (shared domain root).

Options -Indexes
DirectoryIndex index.html

# Block direct access to dotfiles (e.g. the FTP-deploy sync-state file).
# .well-known/ stays reachable: requests target files inside it whose names
# do not start with a dot (ACME challenge, etc.).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Site ships a 404.html; serve it for misses instead of Apache's default.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# llms.txt + raw .md/.mdx mirrors: declare UTF-8 + type; keep mirrors out of the index.
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType text/markdown .md .mdx
  AddCharset UTF-8 .txt .md .mdx
</IfModule>
<FilesMatch "\.mdx?$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>
<FilesMatch "^llms(-full|-small)?\.txt$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>

# Agent discovery (isitagentready) — Apache port of dist/_headers + dist/vercel.json.
# Apache ignores those files; this is what actually ships headers on Hostico.
<IfModule mod_mime.c>
  AddType application/json .json
</IfModule>

# Compound extension needs a filename match — AddType splits on dots.
<FilesMatch "\.tar\.gz$">
  ForceType application/gzip
</FilesMatch>

# Homepage Link header (RFC 8288 / RFC 9727 s3). Minimal form; keep in sync with dist/_headers.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/$" IS_HOMEPAGE
  SetEnvIf Request_URI "^/index\.html$" IS_HOMEPAGE
</IfModule>
<IfModule mod_headers.c>
  Header merge Vary Accept
  Header always set Link "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/ai-catalog+json\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\", </agent-readability.json>; rel=\"describedby\"; type=\"application/json\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\"" env=IS_HOMEPAGE
  # Internal rewrites rename request env vars with a REDIRECT_ prefix.
  Header always set Link "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/ai-catalog+json\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\", </agent-readability.json>; rel=\"describedby\"; type=\"application/json\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\"" env=REDIRECT_IS_HOMEPAGE
  # Internal rewrites rename request env vars with a REDIRECT_ prefix.
</IfModule>

# Extensionless file needs explicit type (else text/plain fails the scan).
<Files "api-catalog">
  ForceType 'application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"'
</Files>

# Serve the catalog with its advertised media type (matches Link rel=ai-catalog).
<Files "ai-catalog.json">
  ForceType application/ai-catalog+json
</Files>

<IfModule mod_headers.c>
  <FilesMatch "(^ai-catalog\.json$|^ard\.json$|^api-catalog$|^agent-readability\.json$|index\.json$)">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Pragmatic Accept: text/markdown (static-first, not strict RFC).
# Layout: /about.md sibling to /about/index.html; /index.md for home.
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_URI} \.(css|js|mjs|map|png|jpe?g|webp|gif|svg|avif|ico|woff2?|ttf|otf|eot|xml|txt|json|pdf|mp4|webm|mp3|wav|ogg|zip)$ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} \.mdx?$ [NC]
RewriteRule ^ - [L]

# / -> /index.md
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{HTTP:Accept} !text/markdown(?:\s*;\s*(?!q\s*=)[^;,]+)*\s*;\s*q\s*=\s*0(\.0*)?(\s*[;,]|\s*$) [NC]
RewriteRule ^$ /index.md [L,T=text/markdown]

# /index.html -> /index.md (same representation as /)
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{HTTP:Accept} !text/markdown(?:\s*;\s*(?!q\s*=)[^;,]+)*\s*;\s*q\s*=\s*0(\.0*)?(\s*[;,]|\s*$) [NC]
RewriteRule ^index\.html$ /index.md [L,T=text/markdown]

# /about[,/] -> /about.md (twin must exist)
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{HTTP:Accept} !text/markdown(?:\s*;\s*(?!q\s*=)[^;,]+)*\s*;\s*q\s*=\s*0(\.0*)?(\s*[;,]|\s*$) [NC]
RewriteCond %{REQUEST_FILENAME} !\.md$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^(.+?)/?$ /$1.md [L,T=text/markdown]
</IfModule>
